# GEMINI / GEMMA API KEY:
# AI Studio automatically injects this from secrets, or configure in .env (ignored by git).
GEMINI_API_KEY=""

# AI Models: Default models for synthesis and decision compilation
# User specified: gemma-4-26b-a4b-it and gemini-3.7-flash
GEMINI_MODEL="gemma-4-26b-a4b-it"
GEMINI_SECONDARY_MODEL="gemini-3.7-flash"

# GOOGLE MAPS PLATFORM API KEY:
# For production satellite and terrain cartography. Kept safe in .env and .gitignore.
VITE_GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# Injected at runtime by AI Studio environment.
APP_URL=""

